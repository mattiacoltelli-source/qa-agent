{
  "name": "qa-agent",
  "private": true,
  "version": "0.1.0",
  "description": "AI QA Agent personale: suite Playwright per CineFighi, CineTracker e Spot (Ionio in barca a vela)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:cinefighi": "playwright test --project=cinefighi-mobile --project=cinefighi-desktop",
    "test:cinetracker": "playwright test --project=cinetracker-mobile --project=cinetracker-desktop",
    "test:vacanza": "playwright test --project=vacanza-mobile --project=vacanza-desktop",
    "test:write": "RUN_WRITE_TESTS=true playwright test --grep @write",
    "setup:cinefighi-qa-user": "node scripts/ensure-cinefighi-qa-user.mjs",
    "cleanup:write-residue": "node scripts/cleanup-write-residue.mjs",
    "stress:cinefighi": "node scripts/stress-cinefighi.mjs",
    "summary": "node scripts/write-summary.mjs",
    "analyze": "node scripts/analyze-failures.mjs",
    "report": "playwright show-report reports/html",
    "health": "node health/engine.mjs",
    "health:cinefighi": "node health/engine.mjs cinefighi",
    "health:cinetracker": "node health/engine.mjs cinetracker",
    "health:spot": "node health/engine.mjs spot",
    "health:analyze": "node health/analyze.mjs",
    "health:summary": "node health/write-summary.mjs",
    "perf": "node perf/engine.mjs",
    "perf:cinefighi": "node perf/engine.mjs cinefighi",
    "perf:cinetracker": "node perf/engine.mjs cinetracker",
    "perf:spot": "node perf/engine.mjs spot",
    "perf:analyze": "node perf/analyze.mjs",
    "perf:summary": "node perf/write-summary.mjs",
    "api-doctor": "node api-doctor/engine.mjs",
    "api-doctor:cinefighi": "node api-doctor/engine.mjs cinefighi",
    "api-doctor:cinetracker": "node api-doctor/engine.mjs cinetracker",
    "api-doctor:spot": "node api-doctor/engine.mjs spot",
    "api-doctor:analyze": "node api-doctor/analyze.mjs",
    "api-doctor:summary": "node api-doctor/write-summary.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.2.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "zod": "^4.4.3"
  }
}
